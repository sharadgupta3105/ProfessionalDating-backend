PORT=5001
NODE_ENV=development

# India launch (default). Swipe daily limit resets at midnight IST.
APP_REGION=IN
APP_TIMEZONE=Asia/Kolkata

# Required — PostgreSQL (Supabase: Project Settings → Database → Connection string → URI).
# On AWS Elastic Beanstalk / EC2 use the **Session pooler** URI (port 6543), NOT direct db.*.supabase.co:5432,
# or you may see ENETUNREACH on IPv6. Password must be URL-encoded (@ → %40).
# Example pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Public API URL (no trailing slash). Set on Render so /uploads/... links use https (trust proxy is enabled in code).
# API_BASE_URL=https://professionaldating-backend.onrender.com

# On each server start, (re)seed powertester@promatch.dev … powertester8@promatch.dev for QA (wipes swipes/chats for those emails). Use only on demo/staging; unset for real production.
# SEED_PROMATCH_TEST_ACCOUNTS=1

# Log Expo push attempts to the API terminal (helps verify iOS/Android push while testing)
# DEBUG_PUSH=1

# If you enabled "Push notifications security" on expo.dev, set a token from:
# https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=
JWT_SECRET=your-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:8081
# Comma-separated origins for REST + Socket.io (Expo web, extra dev URLs). Defaults to FRONTEND_URL.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Email OTP via Resend (https://resend.com) — see backend/OTP_EMAIL_SETUP.md
# When set, POST /auth/login emails a 6-digit code (production + local).
RESEND_API_KEY=
# Sender: test = LinkedUp <onboarding@resend.dev> | production = LinkedUp <noreply@yourdomain.com>
OTP_FROM_EMAIL=LinkedUp <onboarding@resend.dev>

# Demo account — fixed OTP, no email (works with Resend enabled for other emails)
DEMO_LOGIN_EMAIL=demo@linkedup.app
DEMO_LOGIN_OTP=123456
# Refresh demo profile on each API start (optional)
# SEED_DEMO_ACCOUNT=1

# QA: same OTP for ALL emails, no email (optional; demo email uses DEMO_LOGIN_OTP first)
# OTP_FIXED_CODE=123456

# Log successful sends (does not log the code)
# DEBUG_OTP=1

# LinkedIn OAuth (Sign in with LinkedIn using OpenID Connect). Create an app at https://www.linkedin.com/developers/
# LinkedIn only allows http/https redirect URLs. Register every redirect your clients use, exactly (character-for-character):
# - Expo Web dev: e.g. http://localhost:8081/linkedin (port must match your dev server).
# - Native / Expo Go: e.g. https://auth.expo.io/@anonymous/mobile
#
# Reliable sign-in on a real phone (bypasses broken auth.expo.io): expose this API over HTTPS (e.g. ngrok http 5001),
# then set the SAME full callback URL here, in LinkedIn "Authorized redirect URLs", and in mobile EXPO_PUBLIC_LINKEDIN_CALLBACK_URL:
# LINKEDIN_OAUTH_CALLBACK_URL=https://YOUR_SUBDOMAIN.ngrok-free.app/auth/linkedin/callback
#
# Optional: comma-separated extra redirect URIs (custom HTTPS, web dev).
# LINKEDIN_REDIRECT_URI_ALLOWLIST=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
